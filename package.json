{
  "name": "podologymk-crm",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "prebuild:pages": "npm run db:generate",
    "deploy:pages": "npm run build:pages && npx wrangler pages deploy out --project-name podologymk-crm --branch main --commit-dirty=true",
    "deploy:notifications": "npx wrangler deploy --config wrangler.notifications.jsonc",
    "db:migrate": "npx wrangler d1 migrations apply podologymk_crm --remote",
    "db:local": "npx wrangler d1 migrations apply podologymk_crm --local",
    "configure:telegram": "node scripts/configure-telegram-bot.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run db:generate",
    "test": "vitest run",
    "pretest": "npm run db:generate",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:pg:migrate": "prisma migrate deploy",
    "db:pg:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
