{
  "name": "podologymk-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "deploy:pages": "npm run build:pages && npx wrangler pages deploy out --project-name podologymk-crm --commit-dirty=true",
    "deploy:notifications": "npx wrangler deploy --config wrangler.notifications.jsonc",
    "db:migrate": "npx wrangler d1 migrations apply podologymk_crm --remote",
    "db:local": "npx wrangler d1 migrations apply podologymk_crm --local",
    "configure:telegram": "node scripts/configure-telegram-bot.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}
