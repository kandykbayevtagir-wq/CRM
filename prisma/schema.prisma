generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMINISTRATOR
  SPECIALIST
  ACCOUNTANT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  CLOSED
}

enum AdjustmentKind {
  BONUS
  DEDUCTION
  ADVANCE
  MANUAL
}

enum ExpenseType {
  RENT
  UTILITIES
  SALARY
  SUPPLIES
  MARKETING
  TAX
  EQUIPMENT
  OTHER
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       Role     @default(ADMINISTRATOR)
  createdAt  DateTime @default(now())
  employee   Employee?
}

model Branch {
  id          String            @id @default(cuid())
  name        String
  address     String?
  phone       String?
  active      Boolean           @default(true)
  employees   Employee[]
  appointments Appointment[]
  expenses    Expense[]
  rentPayments RentPayment[]
  utilities   UtilityPayment[]
  createdAt   DateTime          @default(now())
}

model Employee {
  id              String              @id @default(cuid())
  fullName        String
  position        String
  phone           String?
  email           String?
  branchId        String
  userId          String?             @unique
  fixedSalary     Decimal?            @db.Decimal(12, 2)
  revenuePercent  Decimal             @default(0) @db.Decimal(5, 2)
  active          Boolean             @default(true)
  branch          Branch              @relation(fields: [branchId], references: [id])
  user            User?               @relation(fields: [userId], references: [id])
  appointments    Appointment[]
  payrollLines    PayrollLine[]
  adjustments     PayrollAdjustment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Client {
  id           String        @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  notes        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id              String              @id @default(cuid())
  name            String
  category        String
  price           Decimal             @db.Decimal(12, 2)
  durationMinutes Int                 @default(60)
  active          Boolean             @default(true)
  appointmentRows AppointmentService[]
}

model Appointment {
  id              String              @id @default(cuid())
  clientId        String
  employeeId      String
  branchId        String
  startsAt        DateTime
  status          AppointmentStatus   @default(SCHEDULED)
  source          String?
  notes           String?
  totalAmount     Decimal             @default(0) @db.Decimal(12, 2)
  client          Client              @relation(fields: [clientId], references: [id])
  employee        Employee            @relation(fields: [employeeId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  services        AppointmentService[]
  payments        Payment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([startsAt])
  @@index([employeeId, startsAt])
  @@index([branchId, startsAt])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  price         Decimal @db.Decimal(12, 2)
  quantity      Int     @default(1)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  paidAt        DateTime      @default(now())
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([paidAt])
}

model PayrollPeriod {
  id          String         @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus  @default(DRAFT)
  totalAmount Decimal        @default(0) @db.Decimal(12, 2)
  lines       PayrollLine[]
  adjustments PayrollAdjustment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([periodStart, periodEnd])
}

model PayrollLine {
  id             String        @id @default(cuid())
  periodId       String
  employeeId     String
  fixedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  revenueAmount  Decimal       @default(0) @db.Decimal(12, 2)
  bonusAmount    Decimal       @default(0) @db.Decimal(12, 2)
  deductionAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  period         PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee       Employee      @relation(fields: [employeeId], references: [id])

  @@unique([periodId, employeeId])
}

model PayrollAdjustment {
  id         String         @id @default(cuid())
  employeeId String
  periodId   String?
  kind       AdjustmentKind
  amount     Decimal        @db.Decimal(12, 2)
  reason     String
  createdAt  DateTime       @default(now())
  employee   Employee       @relation(fields: [employeeId], references: [id])
  period     PayrollPeriod? @relation(fields: [periodId], references: [id])
}

model ExpenseCategory {
  id       String      @id @default(cuid())
  name     String      @unique
  type     ExpenseType
  expenses Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  branchId    String?
  categoryId  String
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  occurredAt  DateTime
  description String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([occurredAt])
}

model RentPayment {
  id          String   @id @default(cuid())
  branchId    String
  periodStart DateTime
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  note        String?
  branch      Branch   @relation(fields: [branchId], references: [id])
}

model UtilityPayment {
  id          String   @id @default(cuid())
  branchId    String
  kind        String
  periodStart DateTime
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  meterValue  Decimal? @db.Decimal(12, 3)
  note        String?
  branch      Branch   @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
